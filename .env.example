# Kontaktformular – Versand via Resend (https://resend.com), HTTPS-API.
# Railway blockiert ausgehendes SMTP auf Nicht-Pro-Plänen; Resend läuft über HTTPS
# und funktioniert daher auf jedem Plan.

# API-Key erstellen: https://resend.com/api-keys
NUXT_RESEND_API_KEY=re_dein_api_key

# Absender: muss eine in Resend verifizierte Domain sein.
# Zum ersten Testen geht ohne Domain-Verifizierung nur "onboarding@resend.dev"
# (sendet ausschließlich an die E-Mail-Adresse deines Resend-Accounts).
NUXT_RESEND_FROM=Portfolio Kontakt <kontakt@konradthiemann.de>

# Empfänger der Kontaktanfragen:
NUXT_CONTACT_TO=konrad.thiemann@gmail.com
